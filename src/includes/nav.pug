nav(aria-label="Main")
  #menuToggle
    input(type="checkbox" aria-label="Menu" aria-controls="menu")

    span
    span
    span

    ul#menu
      li: a(href="index.html#home") Home
      li: a(href="index.html#system") A³ System
      li: a(href="index.html#parts") The parts
      li: a(href="#footer") Contact

  //- In-page links leave the checkbox menu open over the target; close it.
  script.
    document.querySelectorAll('#menu a').forEach(function (link) {
      link.addEventListener('click', function () {
        document.querySelector('#menuToggle input').checked = false;
      });
    });
