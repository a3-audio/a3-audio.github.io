section#system.light
  div
    h2 System
    .flex-container

      #motion
        a(href="https://a3-audio.github.io/a3-doc/user/a3motion.html") 
          img.screen(src='./img/a3-motion-screen.jpg' alt='A³ Motion: the sphere with four channels moving')
          h3 A³ Motion
          p.subline 4-Channel Motion Sampler
          ul
            li control motion via touch
            li 4 patterns per channel
            li beat-synced
            li OSC output

      #mixer
        a(href="https://a3-audio.github.io/a3-doc/user/a3mix.html") 
          img.screen(src='./img/a3-desk-screen.jpg' alt='A³ Mixer: the desk with four channels playing')
          h3 A³ Mixer
          p.subline 4-Channel DJ Mixer
          ul
            li control spatialization per channel
            li pre-listen binaural 3D
            li FX section
            li OSC output

      #stemdeck-card
        a(href="https://a3-audio.github.io/a3-doc/user/stemdeck.html") 
          img.screen(src='./img/a3-stemdeck-screen.jpg' alt='StemDeck: one deck playing, its four stems on their own paths')
          h3 StemDeck
          p.subline Stem Player
          ul
            li four stems per deck, moved one by one
            li up to four decks
            li beat-synced actions per stem
            li Pro DJ Link tempo master

      #core
        a(href="https://a3-audio.github.io/a3-doc/user/audio-engine.html") 
          img(src='./img/a3-core-icon_dark.svg' alt='A³ Engine')
          h3 A³ Engine
          p.subline 3D Audio Engine
          ul
            li spatialization, mixing, effects
            li speaker setup in its own window
            li any audio interface
            li full control via OSC
